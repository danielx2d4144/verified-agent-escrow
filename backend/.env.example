# Copy to .env and fill in — never commit a real .env with keys.
# Verified testnet values below are from RESEARCH.md (21 Nov 2026).
# ESCROW_CONTRACT_INDEX / module ref stay empty until Step 2 deploys.

PORT=3000
CONCORDIUM_NETWORK=testnet
# Testnet Agent Registry (CIS-8004): <12802, 0>
# Testnet CIS-8 External Key Registry: <12801, 0>
# Testnet genesis hash: 4221332d34e1694168c2a0c0b3fd0f273809612cb13d000d5c2e00e85f50f796
# Testnet CAIP-2 chain id: ccd:4221332d34e1694168c2a0c0b3fd0f27
# Testnet Agent Registry DApp: https://testnet-agent-registry.concordium.com/dashboard
# Agent Registry indexer: https://agent-registry-indexer.concordium.com/agents?network=testnet&status=Active
REGISTRY_CIS8004_INDEX=12802
REGISTRY_CIS8_INDEX=12801

# Hosted MCP server — documented, but live behaviour NOT verified
# (initialize probe returned no response 21 Nov 2026). verifyBadgeMcp()
# throws until it is verified. Use the REST endpoint instead.
MCP_URL=https://agent-registry-mcp.concordium.com/mcp
# REST badge-check — VERIFIED on testnet 21 Nov 2026, no query parameter
# (network is resolved from the badge itself; ?network=testnet is accepted
# but redundant). Example (mainnet badge, from docs):
# https://agent-registry-mcp.concordium.com/v1/badge-check/Mf22soLh1NuZYFgBK8iSs
BADGE_CHECK_URL=https://agent-registry-mcp.concordium.com/v1/badge-check

# Escrow contract on testnet — TODO after deploy (BUILD_PLAN.md Step 2).
ESCROW_CONTRACT_INDEX=
ESCROW_CONTRACT_SUBINDEX=0
ESCROW_MODULE_REF=
# Testnet node — verified: grpc.testnet.concordium.com:20000
CONCORDIUM_NODE=grpc.testnet.concordium.com:20000
# Testnet explorer homepage — verified HTTP 200 (21 Nov 2026).
# Contract/tx deep-link pattern UNVERIFIED (guessed patterns 404).
CCDEXPLORER_TESTNET=https://ccdexplorer.io/testnet
CCDSCAN=https://ccdscan.io/

# Settlement mode: "local" (default, in-memory, settledOnChain: false)
# or "testnet" (throws until the SDK wiring exists — see escrow.ts).
ESCROW_MODE=local

# Test agents — TODO: real testnet badges from Step 0 (needs Daniel).
# Do NOT use the docs' example badge Mf22soLh1NuZYFgBK8iSs (a mainnet
# example, not Daniel's). Testnet badges seen in live probes (NOT Daniel's
# agents — old test agents, both badge_valid: false):
#   token 0: JyP9TtQC3HCNrTYR3sc2T (card URL 404s, hash mismatch)
#   token 8: JyP9U3A3VVBoVTSm7QdSw (on-chain metadata_hash null)
BUYER_BADGE=
SELLER_BADGE=
REVOCABLE_SELLER_BADGE=

# Demo escrow amount, in microCCD (test CCD only — worth nothing).
DEMO_AMOUNT_MICROCCD=1000000
